! spectral input for the SYNTHETIC model slab (NOT DFT). See README.md.
! The model is built with E_F = 0 by construction; spectral never shifts energies.
&SPECTRAL
    h_file           = 'model_H.hsio'
    s_file           = 'model_S.hsio'
    structure_file   = 'model.nml'
    regions_file     = 'regions.nml'
    spin_mode        = 'none'
    method           = 'mulliken'
    energy_reference = 'fermi'
    output_prefix    = 'model'
    write_text       = .true.
/
&KPATH
    nvertex = 3
    vertex(:,1) = 0.5, 0.0, 0.0
    vertex(:,2) = 0.0, 0.0, 0.0
    vertex(:,3) = 0.5, 0.5, 0.0
    label   = 'X', 'G', 'M'
    npoints = 60, 85
/
